{
  "id": "builtin.heap-snapshot-viewer",
  "name": "Heap Snapshot Viewer",
  "description": "Heap Snapshot Viewer",
  "repository": "https://github.com/lvce-editor/heap-snapshot-viewer",
  "browser": "dist/heapSnapshotViewerMain.js",
  "isolated": true,
  "workerName": "Heap Snapshot Viewer Extension Worker",
  "configuration": {
    "heapSnapshotViewer.showTimings": {
      "type": "boolean",
      "default": false,
      "description": "Show heap snapshot processing timings in the viewer."
    }
  },
  "rpc": [
    {
      "id": "builtin.heap-snapshot-viewer.parser-worker",
      "type": "web-worker",
      "name": "Heap Snapshot Parser Worker",
      "url": "dist/heapSnapshotParserWorkerMain.js",
      "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"]
    }
  ],
  "activation": ["onView:builtin.heap-snapshot-viewer"],
  "languages": [],
  "views": [
    {
      "id": "builtin.heap-snapshot-viewer",
      "title": "Heap Snapshot Viewer",
      "kind": "virtualDom",
      "type": "preview",
      "css": "media/index.css",
      "selector": [".heapsnapshot"],
      "showSideBarHeader": false
    }
  ]
}
